# ==========================================
# CrimeLens AI Backend - Environment Variables
# ==========================================

# MongoDB Atlas
# Replace the placeholders with your own MongoDB Atlas credentials.
# Never commit actual credentials to GitHub.

MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/?appName=CrimeLensCluster

# MongoDB database name
DATABASE_NAME=crimelens_db

# Frontend URL used for CORS
FRONTEND_URL=http://localhost:5173